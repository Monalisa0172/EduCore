@inherits LayoutComponentBase

<BrandTheme />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />
        <a class="header-marca" href="" aria-label="EduCore - página inicial">
            <span class="header-marca-icone" aria-hidden="true">
                <FluentIcon Value="@(new Icons.Filled.Size20.HatGraduation())" Color="Color.Custom" CustomColor="var(--educore-primary)" />
            </span>
            <span class="header-marca-texto">EduCore</span>
        </a>
        <FluentSpacer />
        <UserMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Class="main">
        <div class="content">
            @Body
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer">
        <FluentText Size="TextSize.Size200">© @DateTime.Now.Year EduCore</FluentText>
    </FluentLayoutItem>
</FluentLayout>

<ErroGlobal />
