@inject NavigationManager Navigation

@* Envia para o login guardando a pagina atual para voltar depois. *@

@code {
    protected override void OnInitialized()
    {
        var atual = Navigation.ToBaseRelativePath(Navigation.Uri);

        // Ao sair, a pagina anterior ainda reage ao logout depois que o endereco ja virou "login":
        // redirecionar daqui gravaria returnUrl=/login e o proximo login voltaria para o proprio login.
        if (PaginasDeAcesso.Contem(atual))
        {
            return;
        }

        var returnUrl = "/" + atual;

        var loginUrl = returnUrl == "/"
            ? "login"
            : $"login?returnUrl={Uri.EscapeDataString(returnUrl)}";

        Navigation.NavigateTo(loginUrl, replace: true);
    }
}
