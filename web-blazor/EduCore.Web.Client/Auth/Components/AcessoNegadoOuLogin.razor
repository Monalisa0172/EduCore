@* Usado no NotAuthorized de telas restritas: sem login vai para o login; logado sem o perfil exigido ve o aviso. *@
@if (_autenticado is true)
{
    <FluentMessageBar Intent="MessageBarIntent.Warning" Title="Acesso negado" AllowDismiss="false">
        Seu perfil não tem permissão para acessar esta página.
    </FluentMessageBar>
}
else if (_autenticado is false)
{
    <RedirectToLogin />
}

@code {
    private bool? _autenticado;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        var estado = await AuthenticationState;
        _autenticado = estado.User.Identity?.IsAuthenticated == true;
    }
}
