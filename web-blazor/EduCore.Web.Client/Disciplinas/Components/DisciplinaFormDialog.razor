@implements IDisposable
@inject IDisciplinaApiClient DisciplinaApi

@* Cadastro e edicao de disciplina em dialogo. Campos com Immediate: o valor chega ao modelo a cada tecla,
   entao clicar direto em "Salvar" nunca envia o valor antigo. *@
<FormDialog @ref="_moldura"
            Titulo="@(_destacarPendencias ? "Completar cadastro" : _modelo.Edicao ? "Editar disciplina" : "Nova disciplina")"
            Descricao="Campos com * são obrigatórios."
            Aviso="@(_destacarPendencias ? TextoPendencias : null)"
            EditContext="_editContext"
            NomeFormulario="disciplina"
            TextoSalvar="@(_modelo.Edicao ? "Salvar alterações" : "Cadastrar disciplina")"
            Salvando="_salvando"
            Erro="_erro"
            OnSalvar="SalvarAsync">
    <div class="campos-grid">
        <FluentTextInput Id="disciplina-nome"
                         Label="Nome"
                         Placeholder="Ex.: Matemática"
                         @bind-Value="_modelo.Nome"
                         Required="true"
                         MaxLength="100"
                         AutoComplete="off"
                         Immediate="true"
                         ImmediateDelay="0"
                         Class="campo-largo" />

        <FluentTextInput Id="disciplina-codigo"
                         Label="Código"
                         Placeholder="Ex.: MAT01"
                         @bind-Value="_modelo.Codigo"
                         Required="true"
                         MaxLength="20"
                         AutoComplete="off"
                         Spellcheck="false"
                         Immediate="true"
                         ImmediateDelay="0" />

        <FluentNumberInput TValue="int?"
                           Id="disciplina-carga"
                           Label="Carga horária (horas)"
                           Placeholder="Ex.: 80"
                           @bind-Value="_modelo.CargaHoraria"
                           Required="true"
                           Immediate="true"
                           ImmediateDelay="0" />
    </div>

    <FluentTextArea Id="disciplina-descricao"
                    Label="Descrição"
                    Placeholder="Opcional: ementa resumida ou observações."
                    @bind-Value="_modelo.Descricao"
                    MaxLength="255"
                    Width="100%"
                    Immediate="true"
                    ImmediateDelay="0" />
</FormDialog>

@code {
    private readonly CancellationTokenSource _cts = new();

    private FormDialog _moldura = default!;
    private DisciplinaFormModel _modelo = DisciplinaFormModel.Nova();
    private EditContext _editContext = default!;
    private ValidationMessageStore _mensagensServidor = default!;
    private ApiError? _erro;
    private bool _salvando;
    private bool _destacarPendencias;

    /// <summary>Disparado depois que a API confirmou a gravação.</summary>
    [Parameter]
    public EventCallback<DisciplinaSalva> OnSalva { get; set; }

    protected override void OnInitialized() => Preparar(_modelo);

    public Task AbrirNovaAsync() => AbrirAsync(DisciplinaFormModel.Nova(), destacarPendencias: false);

    /// <param name="destacarPendencias">
    /// Abre já validado: os campos obrigatórios vazios (ex.: código de disciplinas antigas) aparecem em vermelho.
    /// </param>
    public Task AbrirEdicaoAsync(DisciplinaItem disciplina, bool destacarPendencias = false)
        => AbrirAsync(DisciplinaFormModel.De(disciplina), destacarPendencias);

    private async Task AbrirAsync(DisciplinaFormModel modelo, bool destacarPendencias)
    {
        Preparar(modelo);
        _destacarPendencias = destacarPendencias;
        StateHasChanged();

        // Deixa o dialogo renderizar com o modelo novo antes de abrir.
        await Task.Yield();
        await _moldura.AbrirAsync();

        if (destacarPendencias)
        {
            _editContext.Validate();
            StateHasChanged();
        }
    }

    private string TextoPendencias
    {
        get
        {
            var faltando = new List<string>();
            if (string.IsNullOrWhiteSpace(_modelo.Codigo))
            {
                faltando.Add("o código");
            }

            if (_modelo.CargaHoraria is not > 0)
            {
                faltando.Add("a carga horária");
            }

            return faltando.Count == 0
                ? "O cadastro já está completo. Revise e salve."
                : $"Esta disciplina foi cadastrada sem {string.Join(" e ", faltando)}. Preencha os campos destacados e salve.";
        }
    }

    private void Preparar(DisciplinaFormModel modelo)
    {
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= AoAlterarCampo;
        }

        _modelo = modelo;
        _erro = null;
        _editContext = new EditContext(modelo);
        _mensagensServidor = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += AoAlterarCampo;
    }

    // O erro devolvido pela API vale ate o usuario mexer no campo.
    private void AoAlterarCampo(object? sender, FieldChangedEventArgs e) => _mensagensServidor.Clear(e.FieldIdentifier);

    private async Task SalvarAsync()
    {
        if (_salvando)
        {
            return;
        }

        _erro = null;
        _mensagensServidor.Clear();

        if (!_editContext.Validate())
        {
            return;
        }

        _salvando = true;

        var request = _modelo.ParaRequest();
        var resultado = _modelo.Edicao
            ? await DisciplinaApi.AtualizarAsync(_modelo.Id!.Value, request, _cts.Token)
            : await DisciplinaApi.CriarAsync(request, _cts.Token);

        _salvando = false;

        if (resultado.Succeeded)
        {
            await _moldura.FecharAsync();
            await OnSalva.InvokeAsync(new DisciplinaSalva(resultado.Value!, Nova: !_modelo.Edicao));
            return;
        }

        _erro = ErrosDeFormulario.Aplicar(resultado.Error, _mensagensServidor, _modelo, DisciplinaFormModel.Campos);
        _editContext.NotifyValidationStateChanged();
    }

    public void Dispose()
    {
        _editContext.OnFieldChanged -= AoAlterarCampo;
        _cts.Cancel();
        _cts.Dispose();
    }
}
