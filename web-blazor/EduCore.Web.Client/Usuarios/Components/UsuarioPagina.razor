@* Moldura das paginas de usuario: cabecalho padrao (trilha, area e titulo) e conteudo.
   Os links da trilha sao <a> nativos; a confirmacao de "descartar alteracoes" e feita pelo UsuarioForm.razor.js. *@
<div class="usuario-pagina">
    <PageHeader Titulo="@Titulo"
                Secao="Pessoas"
                Icone="Icone"
                Descricao="@Descricao"
                Trilha="@(Trilha ?? [ItemTrilha.Inicio, new(Titulo)])">
        <Detalhes>@Resumo</Detalhes>
    </PageHeader>

    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Titulo { get; set; } = string.Empty;

    [Parameter]
    public string? Descricao { get; set; }

    [Parameter]
    public Icon Icone { get; set; } = new Icons.Regular.Size24.Person();

    /// <summary>Trilha quando a página é aberta de outro lugar (ex.: a partir de uma turma). Padrão: Início › Título.</summary>
    [Parameter]
    public IReadOnlyList<ItemTrilha>? Trilha { get; set; }

    /// <summary>Conteúdo extra do cabeçalho (ex.: quem está sendo editado).</summary>
    [Parameter]
    public RenderFragment? Resumo { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
