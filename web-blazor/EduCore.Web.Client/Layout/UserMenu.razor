@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IAuthService AuthService
@inject NavigationManager Navigation

@* Fica no cabecalho azul da marca: textos usam a cor "sobre a marca" para manter contraste. *@
<AuthorizeView>
    <Authorized>
        <div class="user-menu">
            @* Nome leva a "Minha conta" (alterar senha). No celular fica so o icone. *@
            <a class="user-menu-conta" href="minha-conta/senha" title="Minha conta: alterar senha (@context.User.Email())" aria-label="Minha conta: alterar senha">
                <FluentIcon Value="@(new Icons.Regular.Size20.PersonCircle())" Color="Color.Custom" CustomColor="currentColor" aria-hidden="true" />
                <span class="user-menu-email">@context.User.NomeExibicao()</span>
            </a>
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          Color="var(--colorNeutralForegroundOnBrand)"
                          IconStart="@(new Icons.Regular.Size20.SignOut())"
                          OnClick="LogoutAsync">
                Sair
            </FluentButton>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
