@inherits HomeViewBase
@inject IBoletimApiClient BoletimApi

@* Pagina inicial do aluno: desempenho por disciplina em graficos (media e frequencia), no bimestre atual. *@
<div class="pagina">
    <PageHeader Titulo="Meu desempenho"
                Secao="Visão geral"
                Icone="@(new Icons.Regular.Size24.DataBarHorizontal())"
                Descricao="@($"Olá, {PrimeiroNome}. Veja como você está em cada disciplina; troque o bimestre para ver os anteriores.")" />

    <BoletimView Carregar="BoletimApi.MeuBoletimAsync" LinkBoletim="aluno/boletim" />
</div>
