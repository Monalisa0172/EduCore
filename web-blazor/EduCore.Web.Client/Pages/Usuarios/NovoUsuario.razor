@page "/usuarios/novo"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Novo usuário | EduCore</PageTitle>

<AreaSegura>
    <AuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <UsuarioPagina Titulo="Novo usuário"
                           Icone="@(new Icons.Regular.Size24.PersonAdd())"
                           Trilha="Trilha"
                           Descricao="Cadastre um aluno ou professor. Campos com * são obrigatórios.">
                <UsuarioForm Model="_modelo"
                             OnSalvar="CriarAsync"
                             UrlRetorno="@UrlRetorno"
                             Turmas="_turmas"
                             ErroTurmas="_erroTurmas"
                             OnRecarregarTurmas="CarregarTurmasAsync" />
            </UsuarioPagina>
        </Authorized>
        <NotAuthorized>
            <AcessoNegadoOuLogin />
        </NotAuthorized>
    </AuthorizeView>
</AreaSegura>
