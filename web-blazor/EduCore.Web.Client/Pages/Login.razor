@page "/login"
@layout AuthLayout
@rendermode InteractiveWebAssembly

<PageTitle>Entrar | EduCore</PageTitle>

<TelaAutenticacao Titulo="Bem-vindo de volta" Subtitulo="Entre com seu e-mail e senha para acessar o EduCore.">
    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" FormName="login" novalidate>
        <DataAnnotationsValidator />

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="20px" HorizontalAlignment="HorizontalAlignment.Stretch">
            @if (SenhaRedefinida && _failure is null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Success" Title="Senha redefinida" AllowDismiss="true">
                    Entre com o seu e-mail e a nova senha.
                </FluentMessageBar>
            }

            @if (_failure is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error"
                                  Layout="MessageBarLayout.MultiLine"
                                  Title="@_failure.Title"
                                  AllowDismiss="true"
                                  Class="login-alert">
                    @_failure.Message
                </FluentMessageBar>
            }

            <FluentTextInput Id="login-email"
                             Label="E-mail"
                             @bind-Value="_model.Email"
                             TextInputType="TextInputType.Email"
                             AutoComplete="username"
                             InputMode="TextInputMode.Email"
                             Spellcheck="false"
                             Placeholder="nome@escola.com"
                             MaxLength="100"
                             Required="true"
                             Immediate="true"
                             ImmediateDelay="0"
                             Autofocus="true"
                             Disabled="_isSubmitting"
                             Size="TextInputSize.Large"
                             Width="100%">
                <StartTemplate>
                    <FluentIcon Value="@(new Icons.Regular.Size20.Mail())" />
                </StartTemplate>
            </FluentTextInput>

            <div class="login-senha">
                <FluentTextInput Id="login-password"
                                 Label="Senha"
                                 @bind-Value="_model.Password"
                                 TextInputType="@(_showPassword ? TextInputType.Text : TextInputType.Password)"
                                 AutoComplete="current-password"
                                 Spellcheck="false"
                                 Placeholder="Digite sua senha"
                                 MaxLength="128"
                                 Required="true"
                                 Immediate="true"
                                 ImmediateDelay="0"
                                 Disabled="_isSubmitting"
                                 Size="TextInputSize.Large"
                                 Width="100%">
                    <StartTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size20.Key())" />
                    </StartTemplate>
                    <EndTemplate>
                        <FluentButton Type="ButtonType.Button"
                                      Appearance="ButtonAppearance.Transparent"
                                      Size="ButtonSize.Small"
                                      IconOnly="true"
                                      IconStart="@PasswordToggleIcon"
                                      Title="@PasswordToggleLabel"
                                      aria-label="@PasswordToggleLabel"
                                      aria-pressed="@(_showPassword ? "true" : "false")"
                                      aria-controls="login-password"
                                      Disabled="_isSubmitting"
                                      OnClick="TogglePasswordVisibility" />
                    </EndTemplate>
                </FluentTextInput>

                @* Leva o e-mail ja digitado, para a pessoa nao precisar digitar de novo. *@
                <a class="login-esqueci" href="esqueci-senha" @onclick="GuardarEmail">Esqueci minha senha</a>
            </div>

            <FluentButton Type="ButtonType.Submit"
                          Appearance="ButtonAppearance.Primary"
                          Size="ButtonSize.Large"
                          Loading="_isSubmitting"
                          Disabled="!CanSubmit"
                          Class="login-submit">
                @(_isSubmitting ? "Entrando..." : "Entrar")
            </FluentButton>
        </FluentStack>
    </EditForm>
</TelaAutenticacao>
